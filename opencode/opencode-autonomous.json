{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "question": "allow",
    "bash": {
      "*": "ask",
      "npm run *": "allow",
      "npm test *": "allow",
      "npx tsc *": "allow",
      "npx eslint *": "allow",
      "npx prettier *": "allow",
      "npx jest *": "allow",
      "npx cypress *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git branch *": "allow",
      "git show *": "allow",
      "git rev-parse *": "allow",
      "git ls-files *": "allow",
      "git fetch *": "allow",
      "git commit *": "deny",
      "git push *": "deny",
      "git reset *": "deny",
      "git checkout *": "deny",
      "git restore *": "deny",
      "git clean *": "deny",
      "rm *": "deny",
      "mv *": "deny",
      "sudo *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "chmod *": "deny",
      "chown *": "deny"
    }
  }
}
